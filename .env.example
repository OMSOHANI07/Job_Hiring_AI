# Copy to .env.local and fill in. Never commit real values.
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.8-flash          # verify current model IDs at https://ai.google.dev/gemini-api/docs/models
STORAGE_DRIVER=local                    # local | neon | supabase
DATABASE_URL=your-neon-connection-string   # Neon dashboard > Connect (pooled), server-side only
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server-side only
SUPABASE_ANON_KEY=your-anon-key                   # only used by the RLS verification test
APP_PASSWORD=choose-a-strong-password
SESSION_SECRET=generate-with-openssl-rand-base64-32
RESEND_API_KEY=re_your_resend_key
RESEND_FROM=Kargo Hiring <onboarding@resend.dev>   # live mode needs a verified domain, e.g. Arjun <arjun@kargo.in>
EMAIL_MODE=redirect                                # redirect (test: all mail to EMAIL_REDIRECT_TO) | live (to candidates)
EMAIL_REDIRECT_TO=you@example.com                  # test recipient; with onboarding@resend.dev it must be your Resend account email
